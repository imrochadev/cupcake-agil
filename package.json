{
  "name": "cupcake-agil",
  "private": true,
  "description": "Loja de cupcakes do Projeto Integrador Transdisciplinar em Engenharia de Software II: catálogo, carrinho, checkout simulado, rastreamento do pedido, painel administrativo e formulário de feedback.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "node --env-file=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:integration": "nuxt build && vitest run --project integration",
    "test:e2e": "nuxt build && playwright test",
    "test:all": "nuxt build && vitest run && playwright test"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.0",
    "better-auth": "^1.7.18",
    "maska": "^3.2.2",
    "mongodb": "^7.8.0",
    "nodemailer": "^10.3.1",
    "nuxt": "^4.6.4",
    "uqr": "^0.1.3",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/simple-icons": "^1.2.101",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/icon": "^2.6.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.14.0",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
