# MongoDB (local: `docker compose up -d mongo`; produção: MongoDB Atlas)
DATABASE_URL=mongodb://127.0.0.1:27031/cupcake_agil

# Better Auth: segredo longo e aleatório (ex.: `openssl rand -base64 32`) e o endereço público do site
BETTER_AUTH_SECRET=troque-por-um-segredo-longo
BETTER_AUTH_URL=http://localhost:3000

# Quem vira administrador ao criar a conta (separados por vírgula)
NUXT_ADMIN_EMAILS=voce@exemplo.com

# Minutos entre as etapas da entrega simulada
NUXT_ETAPA_MINUTOS=2

# Login social (cada botão só aparece com as duas variáveis do provedor)
# Retorno do OAuth: <BETTER_AUTH_URL>/api/auth/callback/google e /api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP do e-mail de senha nova (opcional: sem ele, o link sai no log do servidor)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Cupcake Ágil <nao-responda@cupcakeagil.dev>
